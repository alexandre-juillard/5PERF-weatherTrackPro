{
  "name": "weather-track-pro",
  "version": "1.0.0",
  "description": "5PERF Mini-Project",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:dev": "node --experimental-loader ts-node/esm ./src/index.ts",
    "start:watch": "node --inspect --watch --experimental-loader ts-node/esm ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "migrate": "node-pg-migrate -m migrations --config-value database",
    "seed": "node scripts/seed.mjs",
    "bench:load": "node bench/load.mjs",
    "bench:micro": "node bench/micro.bench.mjs",
    "pdf": "node docs/build-pdf.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "author": "SUPINFO",
  "license": "ISC",
  "devDependencies": {
    "@tsconfig/node20": "^20.1.2",
    "@types/config": "^3.3.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.10.9",
    "@types/pg-cursor": "^2.7.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autocannon": "^9.0.0",
    "dayjs": "^1.11.23",
    "eslint": "^8.56.0",
    "eslint-plugin-sonarjs": "^0.25.1",
    "jest": "^29.7.0",
    "marked": "^18.2.0",
    "mitata": "^1.0.34",
    "node-pg-migrate": "^9.0.0",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "config": "^3.3.9",
    "express": "^4.18.2",
    "ioredis": "^6.0.0",
    "pg": "^8.11.3",
    "pg-cursor": "^2.22.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  }
}
